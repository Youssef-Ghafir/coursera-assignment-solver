{
  "manifest_version": 3,
  "name": "Coursera Auto Solver",
  "version": "1.0.0",
  "description": "An AI-powered extension to instantly auto-complete Coursera videos, readings, and automatically solve quizzes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.coursera.org/learn/*",
        "*://mark.skills.network/*",
        "*://*.skills.network/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "run_at": "document_start",
      "matches": [
        "*://*.coursera.org/learn/*"
      ],
      "js": [
        "intercept.js"
      ],
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "*://*.coursera.org/*",
    "*://*.skills.network/*",
    "*://generativelanguage.googleapis.com/*",
    "*://api.openai.com/*",
    "*://api.groq.com/*",
    "*://api.anthropic.com/*",
    "*://openrouter.ai/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Coursera Auto Solver",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["notes.html", "flashcards.html"],
    "matches": ["<all_urls>"]
  }]
}